# Wedding Hub — Caddy front door (behind Cloudflare Tunnel)
#
# Cloudflare terminates TLS at the edge. Cloudflared (on br0) connects to
# this Caddy at 192.168.50.25:80 over plain HTTP via the encrypted tunnel.
# So Caddy serves :80 only — no certs, no Let's Encrypt, no port 443.
#
# Security headers stay (browser-enforced, work fine when Cloudflare passes
# them through). Real-client-IP is pulled from CF-Connecting-IP.

{
	# No public-facing TLS to manage — Cloudflare handles it.
	auto_https off
	# Shrink attack surface: no admin API needed.
	admin off
	servers {
		# HTTP/1.1 is all we need to cloudflared.
		protocols h1
	}
}

# Listen on :80 only. This socket is reachable only via the Cloudflare
# Tunnel (and inside the Unraid LAN if you ever want to test directly).
:80 {
	encode zstd gzip

	# ── Security headers ─────────────────────────────────────────────────
	header {
		# 2y HSTS — browser sees this on the HTTPS response Cloudflare serves,
		# so it works fine even though we deliver plain HTTP to cloudflared.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-site"
		# Strip Caddy's banner.
		-Server
	}

	# ── Reject discovery probes ──────────────────────────────────────────
	@dotfiles path /.git/* /.env* /.well-known/security.txt
	respond @dotfiles "Not found" 404

	@scans path_regexp ^/(wp-admin|wp-login|xmlrpc|phpmyadmin|.well-known/acme-challenge/dummy)
	respond @scans 404

	# ── MCP is LAN-only ──────────────────────────────────────────────────
	# The tunnel must never reach the MCP endpoint — it lives on the :8090
	# LAN listener below. `respond` sorts before `reverse_proxy` in Caddy's
	# directive order, so this wins wherever it sits; placing it above the
	# proxy anyway is belt-and-braces.
	@mcp path /api/mcp*
	respond @mcp "Forbidden" 403

	# Cap any single request body. The app accepts files up to 25 MB
	# (see src/lib/uploads.ts MAX_UPLOAD_BYTES), so 26 MB here gives a
	# small allowance for multipart framing overhead.
	request_body {
		max_size 26MB
	}

	# ── Reverse proxy to the Next.js container ───────────────────────────
	# Tell upstream the original scheme was HTTPS (Cloudflare→user is HTTPS).
	# Pull the real client IP from Cloudflare's CF-Connecting-IP header so
	# Next.js logs / rate-limit see the actual user IP, not cloudflared's.
	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}

	log {
		output stdout
		format console
		level INFO
	}
}

# ── LAN-only MCP listener ────────────────────────────────────────────────
# Reachable at 192.168.50.25:8090 from the LAN (br0 macvlan — no compose
# `ports:` change needed). The Cloudflare Tunnel only routes :80, so this
# socket is never internet-exposed. Auth lives at the app layer: per-user
# bearer tokens plus a Host-header allowlist (MCP_LAN_HOST).
:8090 {
	# MCP requests are single JSON-RPC messages — 2 MB is generous.
	request_body {
		max_size 2MB
	}

	# Mutually exclusive handle blocks: a bare `respond` would otherwise
	# sort before `reverse_proxy` in Caddy's directive order and swallow
	# the MCP path too.
	handle /api/mcp* {
		reverse_proxy web:3000 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	# Nothing else exists on this port.
	handle {
		respond "Not found" 404
	}

	log {
		output stdout
		format console
		level INFO
	}
}
