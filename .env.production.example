# Wedding Hub — production env (used by docker-compose)
#
# Copy this to `.env` next to docker-compose.yml on the host:
#   cp .env.production.example .env
# then fill in every value below before running `docker compose up -d`.

# ─── Domain ────────────────────────────────────────────────────────────
# TLS is terminated by Cloudflare at the edge — no Let's Encrypt here.
DOMAIN=wedding.spencer-net.com

# ─── Database ──────────────────────────────────────────────────────────
# Strong random string. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# ─── Auth.js (v5) ──────────────────────────────────────────────────────
# 32+ random bytes. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Sign-in is restricted to this csv list. Anyone else bounces at /signin/error.
AUTH_ALLOWED_EMAILS=jamie@example.com,bryony@example.com,josh@example.com,aimee@example.com,planner@example.com

# ─── Email (magic-link delivery) ───────────────────────────────────────
# A real SMTP relay — Mailgun, Resend, your provider's SMTP, etc.
# If left blank, magic-link URLs are printed to the web container's logs.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=Wedding Hub <noreply@spencer-net.com>

# ─── App ───────────────────────────────────────────────────────────────
WEDDING_DATE=2026-09-26T14:00:00Z
