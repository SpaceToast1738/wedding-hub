// Wedding Hub schema — Postgres
// All entities the prototype manipulates, with Auth.js tables for magic-link sessions.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js tables ─────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?    // legacy single-string display name; auto-synced from firstName + lastName when those are set
  firstName     String?
  lastName      String?
  image         String?
  emailVerified DateTime?
  role          UserRole   @default(VIEWER)
  isCouple      Boolean    @default(false)
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  COUPLE
  WEDDING_PARTY
  PLANNER
  VIEWER
}

// ─── Domain ────────────────────────────────────────────────────────────────

model Household {
  id          String   @id @default(cuid())
  name        String
  side        Side     @default(BOTH)
  notes       String?  @db.Text
  guests      Guest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Side {
  BRIDE
  GROOM
  BOTH
}

model Guest {
  id              String         @id @default(cuid())
  householdId     String
  household       Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  email           String?
  phone           String?
  rsvp            RsvpStatus     @default(PENDING)
  attending       Boolean?
  isChild         Boolean        @default(false)
  needsHighchair  Boolean        @default(false)
  plusOneAllowed  Boolean        @default(false)
  plusOneName     String?
  role            String?        // Best Man, Maid of Honour, etc.
  side            Side           @default(BOTH)
  mealCourseId    String?
  mealCourse      MealOption?    @relation(fields: [mealCourseId], references: [id])
  // Free-text three-course choices (populated by the CSV import). These
  // coexist with mealCourse FK above, which was structured but never UI-
  // wired; real Say I Do data is messy enough that free-text is honest.
  mealStarter     String?
  mealMain        String?
  mealDessert     String?
  dietary         String[]       @default([])
  songRequests    SongRequest[]
  tableSeatId     String?        @unique
  tableSeat       Seat?          @relation(fields: [tableSeatId], references: [id])
  // Per-party RSVP URL from Say I Do — typically shared across all guests in
  // a household, so this is NOT unique. Stored on Guest rather than Household
  // for forward-compat in case a platform ever issues per-guest links.
  rsvpUniqueLink  String?
  childrenMeal    Boolean        @default(false)
  archived        Boolean        @default(false)
  notes           String?        @db.Text
  tags            String[]       @default([])
  lastNudgedAt    DateTime?
  // Self-relation for plus-ones. When a host has plusOneAllowed=true and
  // plusOneName set and rsvp=ATTENDING, we materialise a child Guest row
  // with parentGuestId pointing at the host. The child shows up in totals
  // (as it's a real Guest row), inherits the host's RSVP / archive state
  // via cascading server actions, and can have its own dietary / meal /
  // song-request rows independently.
  //
  // Cascade on parent hard-delete so a real DB cleanup doesn't leave an
  // orphan +1 row (the soft-archive path is handled in actions.ts and
  // mirrors the host's archived state explicitly).
  parentGuestId   String?
  parentGuest     Guest?         @relation("PlusOneOf", fields: [parentGuestId], references: [id], onDelete: Cascade)
  plusOnes        Guest[]        @relation("PlusOneOf")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([householdId])
  @@index([rsvp])
  @@index([parentGuestId])
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINED
  MAYBE
}

model MealOption {
  id     String  @id @default(cuid())
  name   String
  course Course
  notes  String?
  guests Guest[]
}

enum Course {
  STARTER
  MAIN
  DESSERT
  CHILDREN
}

model SongRequest {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  title     String
  artist    String?
  playlistId String?
  playlist  Playlist? @relation(fields: [playlistId], references: [id])
  createdAt DateTime @default(now())
}

// ─── Tasks / Questions ─────────────────────────────────────────────────────

model Task {
  id           String      @id @default(cuid())
  title        String
  type         TaskType    @default(TASK)
  status       TaskStatus  @default(OPEN)
  priority     Priority    @default(MEDIUM)
  assigneeId   String?
  dueDate      DateTime?
  notes        String?     @db.Text
  decisionAnswer String?   @db.Text
  questionAnswer String?   @db.Text
  budgetTagged Boolean     @default(false)
  tags         String[]    @default([])
  parentId     String?
  parent       Task?       @relation("TaskChildren", fields: [parentId], references: [id])
  children     Task[]      @relation("TaskChildren")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([type])
}

enum TaskType {
  TASK
  QUESTION
  DECISION
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  WAITING
  DONE
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Schedule ──────────────────────────────────────────────────────────────

model ScheduleEvent {
  id          String    @id @default(cuid())
  title       String
  startTime   DateTime
  endTime     DateTime?
  location    String?
  notes       String?   @db.Text
  audience    String[]  @default([])  // personas: couple, party, guests, suppliers
  motif       String?   // illustration key
  printable   Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startTime])
}

// ─── Suppliers ─────────────────────────────────────────────────────────────

model Supplier {
  id              String                  @id @default(cuid())
  name            String
  category        String                  // venue, photographer, florist, etc.
  status          SupplierStatus          @default(SHORTLIST)
  website         String?
  notes           String?                 @db.Text
  amountAgreed    Decimal?                @db.Decimal(10, 2)
  contacts        SupplierContact[]
  contracts       SupplierContract[]
  communications  SupplierCommunication[]
  payments        Payment[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([category])
}

enum SupplierStatus {
  SHORTLIST
  CONTACTED
  QUOTED
  BOOKED
  PAID
  REJECTED
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  role       String?
  email      String?
  phone      String?
  primary    Boolean  @default(false)
}

model SupplierContract {
  id         String    @id @default(cuid())
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fileId     String?
  file       File?     @relation(fields: [fileId], references: [id])
  signed     Boolean   @default(false)
  signedAt   DateTime?
  amount     Decimal?  @db.Decimal(10, 2)
  notes      String?
}

model SupplierCommunication {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  channel    String   // email, call, meeting
  summary    String   @db.Text
  followUpAt DateTime?
  createdById String?
  createdAt  DateTime @default(now())
}

// ─── Budget / Payments ─────────────────────────────────────────────────────

model BudgetCategory {
  id        String       @id @default(cuid())
  name      String
  order     Int          @default(0)
  lines     BudgetLine[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model BudgetLine {
  id          String         @id @default(cuid())
  categoryId  String
  category    BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  description String
  estimated   Decimal?       @db.Decimal(10, 2)
  actual      Decimal?       @db.Decimal(10, 2)
  paid        Decimal?       @db.Decimal(10, 2)
  supplierId  String?
  payments    Payment[]
  notes       String?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Payment {
  id           String        @id @default(cuid())
  description  String
  amount       Decimal       @db.Decimal(10, 2)
  status       PaymentStatus @default(DUE)
  dueDate      DateTime?
  paidDate     DateTime?
  method       String?
  supplierId   String?
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  budgetLineId String?
  budgetLine   BudgetLine?   @relation(fields: [budgetLineId], references: [id])
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([dueDate])
}

enum PaymentStatus {
  DUE
  SCHEDULED
  PAID
  OVERDUE
  CANCELLED
}

// ─── Wedding Book ──────────────────────────────────────────────────────────

model BookSection {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  illustration String?
  order       Int              @default(0)
  subsections BookSubsection[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model BookSubsection {
  id         String      @id @default(cuid())
  sectionId  String
  section    BookSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slug       String
  title      String
  // Tabbed editable fields stored as structured JSON: { tab: [{ key, label, value }] }
  fields     Json?
  body       String?     @db.Text  // freeform notes
  order      Int         @default(0)
  updatedAt  DateTime    @updatedAt

  @@unique([sectionId, slug])
}

// ─── Photography shot list ────────────────────────────────────────────────
//
// Lives under the Wedding Book section in the UI but stored separately
// because the data model (checkboxes + multi-name target list) doesn't fit
// the BookSubsection JSON-fields archetype. withWhom is a free-text list
// rather than a Guest relation: shot lists describe people by display name,
// and we don't want a deleted Guest to silently remove a planned shot.

model PhotographyShot {
  id         String    @id @default(cuid())
  title      String
  withWhom   String[]  @default([])
  location   String?
  notes      String?   @db.Text
  captured   Boolean   @default(false)
  capturedAt DateTime?
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ─── Seating ───────────────────────────────────────────────────────────────

model Table {
  id        String   @id @default(cuid())
  name      String
  shape     TableShape @default(ROUND)
  capacity  Int
  posX      Float    @default(0)
  posY      Float    @default(0)
  rotation  Float    @default(0)
  seats     Seat[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TableShape {
  ROUND
  RECTANGLE
  HEAD
}

model Seat {
  id      String  @id @default(cuid())
  tableId String
  table   Table   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  index   Int
  guest   Guest?  // backref via Guest.tableSeatId
  proposed Boolean @default(false)

  @@unique([tableId, index])
}

// ─── Files ─────────────────────────────────────────────────────────────────

model File {
  id           String             @id @default(cuid())
  name         String
  storedPath   String             // relative to /uploads
  mimeType     String
  sizeBytes    Int
  folder       String?            // contracts, menus, photos, etc.
  visibility   FileVisibility     @default(EVERYONE)
  uploadedById String?
  contracts    SupplierContract[]
  createdAt    DateTime           @default(now())
}

enum FileVisibility {
  EVERYONE     // visible to everyone with files-section access
  COUPLE_ONLY  // visible only to couple-tier users (Jamie + Bryony)
}

// ─── Songs / Playlists ─────────────────────────────────────────────────────

model Playlist {
  id           String        @id @default(cuid())
  name         String
  category     PlaylistCategory
  description  String?
  spotifyId    String?
  spotifyUrl   String?
  // Sync metadata: when the playlist was last pulled from Spotify, plus any
  // error from that attempt (rate limit, 404 if made private, etc.).
  // Both null means "never synced".
  lastSyncedAt   DateTime?
  lastSyncError  String?
  lastSyncedSongs Int?
  isBlockList  Boolean       @default(false)
  songs        Song[]
  songRequests SongRequest[]
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum PlaylistCategory {
  MUST_PLAY
  FIRST_DANCE
  CEREMONY
  DO_NOT_PLAY
  BRIDAL_PREP
  DRINKS_RECEPTION
  WEDDING_BREAKFAST
}

model Song {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  title      String
  artist     String?
  spotifyUri String?
  source     String?  // "guest request", "couple", "DJ"
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

// ─── Permissions / audit ───────────────────────────────────────────────────

model Permission {
  id      String          @id @default(cuid())
  userId  String
  section String          // tasks, guests, budget, etc.
  level   PermissionLevel @default(VIEW)

  @@unique([userId, section])
}

enum PermissionLevel {
  NONE
  VIEW
  EDIT
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

// Tracks magic-link send attempts for rate-limiting. The auth flow checks
// recent rows for a given email before sending; rows older than the rate-
// limit window are pruned opportunistically on the same check. Designed
// to stay tiny (a few hundred rows max in normal operation).
model MagicLinkAttempt {
  id         String   @id @default(cuid())
  identifier String   // email address (lowercased)
  ip         String?  // best-effort; null when the auth callback can't access headers
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([createdAt])
}

// ─── Custom fields (Settings) ──────────────────────────────────────────────

model CustomField {
  id        String   @id @default(cuid())
  entity    String   // "guest", "supplier", etc.
  name      String
  type      String   // text, number, date, select
  options   String[] @default([])
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([entity, name])
}
