# next-auth@5.0.0-beta.25 declares peerOptional nodemailer ^6.6.5;
# @auth/prisma-adapter cascades @auth/core@0.41.2 which declares
# peerOptional nodemailer ^7.0.7. There is no single nodemailer version
# that satisfies both, but BOTH are peerOptional — neither is a real
# runtime requirement.
#
# next-auth is the package that actually `require`s nodemailer (via
# next-auth/providers/nodemailer), so we install nodemailer 6.
# @auth/prisma-adapter doesn't touch nodemailer at runtime; its peer
# is purely declarative. legacy-peer-deps tells npm to ignore the
# resulting "conflict" rather than fail npm ci.
#
# Without this file, `npm ci` on node:20-alpine (npm 10.8.2) fails
# with ERESOLVE; local Windows npm tolerates it silently. .npmrc
# normalises the behaviour across both environments.
legacy-peer-deps=true
