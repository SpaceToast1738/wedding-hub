# ─── Database ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:dev@localhost:5432/wedding_hub?schema=public"

# ─── Auth.js (v5) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Sign-in is restricted to this csv list. Anyone else bounces at /signin/error.
# Keep these in sync with the USER_*_EMAIL vars below.
AUTH_ALLOWED_EMAILS="jamie@example.com,bryony@example.com,josh@example.com,aimee@example.com,planner@example.com"

# ─── Seed: per-user email overrides ────────────────────────────────────
# Used by `npm run db:seed` to upsert the 5 known users with the right
# names + roles. Edit these to the real addresses before seeding prod.
USER_JAMIE_EMAIL="jamie@example.com"
USER_BRYONY_EMAIL="bryony@example.com"
USER_JOSH_EMAIL="josh@example.com"
USER_AIMEE_EMAIL="aimee@example.com"
USER_PLANNER_EMAIL="planner@example.com"

# ─── Email (magic-link delivery via Nodemailer) ────────────────────────
# Leave EMAIL_SERVER_HOST blank in dev — the magic link will be logged
# to the server console instead of sent.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Wedding Hub <noreply@wedding.spencer-net.com>"

# ─── Spotify (read-only playlist sync) ────────────────────────────────
# Optional. Leave blank to disable the Sync button on the Songs page.
# Get credentials at https://developer.spotify.com/dashboard — create an
# app with type "Web API". Spotify only reads PUBLIC playlists with these
# Client Credentials, so the couple has to flip the playlist to public
# during a sync (they can flip it back after).
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# ─── App ───────────────────────────────────────────────────────────────
WEDDING_DATE="2026-09-26T14:00:00Z"
# Used in the catering brief letterhead. Falls back to sensible defaults.
WEDDING_VENUE="Alveston Manor, Stratford-upon-Avon"
WEDDING_COUPLE="Spencer · Olwyn-Davis Wedding"
